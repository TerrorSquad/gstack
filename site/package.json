{
  "name": "gstack-site",
  "version": "1.0.0",
  "private": true,
  "description": "Docs + showcase site for GStack, deployed to Cloudflare Pages.",
  "scripts": {
    "build": "node scripts/ensure-root-tsconfig.mjs && nuxi build",
    "dev": "nuxi dev",
    "generate": "node scripts/ensure-root-tsconfig.mjs && nuxi generate",
    "postinstall": "nuxi prepare",
    "preview": "nuxi preview",
    "screenshots": "node scripts/screenshots.mjs"
  },
  "devDependencies": {
    "@iconify-json/lucide": "1.2.121",
    "@iconify-json/simple-icons": "1.2.93",
    "@iconify-json/vscode-icons": "1.2.68",
    "@playwright/test": "^1.62.1",
    "docus": "^5.12.3",
    "nuxt": "^4.5.1",
    "shiki": "^4.4.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "better-sqlite3",
      "esbuild",
      "sharp",
      "unrs-resolver",
      "vue-demi"
    ]
  }
}
