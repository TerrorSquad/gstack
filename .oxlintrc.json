{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "vue", "import", "promise", "vitest"],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "error"
  },
  "env": {
    "builtin": true
  },
  "ignorePatterns": ["designs/**"],
  "rules": {
    "no-console": ["warn", { "allow": ["warn", "error"] }],
    "typescript/no-explicit-any": "warn",
    "unicorn/prefer-node-protocol": "error",
    // A small helper reads best next to its one use; hoisting it only moves it away.
    "unicorn/consistent-function-scoping": "off"
  },
  "overrides": [
    {
      // Leading **/ so this reaches site/scripts too, not just the root ones —
      // a build script is a build script wherever it lives, and the nested copy
      // was failing CI on rules the root copy is exempt from.
      "files": ["**/scripts/**", "**/tools/**"],
      "rules": {
        "no-console": "off",
        "no-await-in-loop": "off",
        "no-underscore-dangle": "off",
        "no-unmodified-loop-condition": "off",
        "no-unused-vars": "off",
        "typescript/no-explicit-any": "off",
        "unicorn/prefer-node-protocol": "off"
      }
    },
    {
      // UI steps run one after another on purpose; page.evaluate callbacks run in the browser, so they must be
      // self-contained and take their constants as same-named arguments.
      "files": ["e2e/**"],
      "rules": { "no-console": "off", "no-await-in-loop": "off", "no-shadow": "off" }
    }
  ]
}
