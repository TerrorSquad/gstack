# Local Supabase: `pnpm supabase start` prints these values.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_KEY=your-anon-or-publishable-key

# Service role key bypasses RLS — server-side only. Read by scripts/ (seed) and
# e2e directly from process.env.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Same service_role key, consumed by the Nuxt app at runtime via
# serverSupabaseServiceRole() (health probe, notification webhook). On Vercel it
# MUST use the NUXT_ prefix to reach the serverless runtime.
NUXT_SUPABASE_SECRET_KEY=your-service-role-key

# --- Optional: everything below is off unless set ---

# Sentry: DSN is public-safe (write-only ingest key). Also set org/project in
# nuxt.config.ts and SENTRY_AUTH_TOKEN here for source-map upload at build.
NUXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# BetterStack log forwarding (server-side). Both must be set or it no-ops.
NUXT_BETTERSTACK_SOURCE_TOKEN=
NUXT_BETTERSTACK_INGEST_URL=

# Notifications subsystem (in-app bell + transactional email). Off by default.
NUXT_PUBLIC_NOTIFICATIONS_ENABLED=false
# Resend API key for transactional email (https://resend.com -> API Keys).
NUXT_RESEND_KEY=
# Shared secret the Supabase notifications DB webhook must send in x-webhook-secret.
# Generate with: openssl rand -hex 32
NUXT_NOTIFICATION_WEBHOOK_SECRET=
# Canonical public origin for email links (prod). Empty = use request origin.
NUXT_SITE_URL=
