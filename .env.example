# Local Supabase: `pnpm supabase start` prints these values.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_KEY=your-anon-or-publishable-key

# Service role key bypasses RLS — server-side only, never expose to the client.
# Consumed by the Nuxt app via serverSupabaseServiceRole() (e.g. /api/health).
# On Vercel it MUST use the NUXT_ prefix to reach the serverless runtime.
NUXT_SUPABASE_SECRET_KEY=your-service-role-key
