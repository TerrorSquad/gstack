{
  "name": "nuxt-supabase-starter",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "db:reset": "supabase db reset && pnpm seed",
    "db:types": "supabase gen types typescript --local --schema public > shared/types/database.types.ts",
    "dev": "nuxt dev",
    "doctor": "tsx --env-file-if-exists=.env scripts/doctor.ts",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "gen:layer": "tsx scripts/gen-layer.ts",
    "generate": "nuxt generate",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "lint:i18n": "node --experimental-strip-types --no-warnings scripts/check-i18n.ts",
    "lint:i18n-keys": "node --experimental-strip-types --no-warnings scripts/check-i18n.ts --keys",
    "postinstall": "nuxt prepare",
    "preview": "nuxt preview",
    "seed": "tsx --env-file=.env scripts/seed/seed.ts",
    "setup": "tsx --env-file-if-exists=.env scripts/setup.ts",
    "supabase": "supabase",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "typecheck": "nuxt typecheck"
  },
  "dependencies": {
    "@nuxt/ui": "^4.9.0",
    "@nuxtjs/i18n": "^10.4.1",
    "@nuxtjs/sitemap": "^8.2.2",
    "@nuxtjs/supabase": "^2.0.9",
    "@pinia/nuxt": "^0.11.3",
    "@resvg/resvg-js": "^2.6.2",
    "@sentry/nuxt": "^10.65.0",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "@vue-email/components": "^0.0.21",
    "@vue-email/render": "^0.0.9",
    "consola": "^3.4.2",
    "date-fns": "^4.4.0",
    "nuxt": "^4.4.8",
    "nuxt-og-image": "^6.7.2",
    "nuxt-security": "^2.6.0",
    "pinia": "^3.0.4",
    "posthog-js": "^1.404.1",
    "satori": "^0.28.0",
    "vue": "^3.5.39",
    "vue-router": "^5.1.0"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.0.0",
    "@iconify-json/lucide": "^1.2.116",
    "@iconify-json/simple-icons": "^1.2.90",
    "@playwright/test": "1.61.1",
    "@supabase/supabase-js": "^2.110.2",
    "@types/node": "^26.1.1",
    "axe-playwright": "^2.2.2",
    "dotenv": "^17.4.2",
    "nuxt-csurf": "^1.6.6",
    "oxfmt": "^0.58.0",
    "oxlint": "^1.73.0",
    "supabase": "^2.109.1",
    "tsx": "^4.23.0",
    "typescript": "~5.9.3",
    "vitest": "^4.1.10",
    "vue-i18n-extract": "^2.0.7",
    "vue-tsc": "^3.3.7"
  }
}
