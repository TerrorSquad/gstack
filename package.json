{
  "name": "gstack",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "db:reset": "supabase db reset && pnpm seed",
    "db:types": "supabase gen types typescript --local --schema public > shared/types/database.types.ts",
    "deploy:prod": "supabase db push --yes && pnpm dlx vercel deploy --prod --yes && pnpm smoke:prod",
    "dev": "nuxt dev",
    "doctor": "tsx --env-file-if-exists=.env scripts/doctor.ts",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "gen:auth-templates": "tsx scripts/gen-auth-templates.ts",
    "gen:layer": "tsx scripts/gen-layer.ts",
    "generate": "nuxt generate",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "lint:guards": "node --experimental-strip-types --no-warnings scripts/guards.ts",
    "lint:i18n": "node --experimental-strip-types --no-warnings scripts/check-i18n.ts && node --experimental-strip-types --no-warnings scripts/check-i18n.ts --keys",
    "lint:i18n-keys": "node --experimental-strip-types --no-warnings scripts/check-i18n.ts --keys",
    "postinstall": "nuxt prepare",
    "prepare": "command -v forge >/dev/null && forge install >/dev/null || echo \"forge not found: git hooks (format, lint, i18n, guards) are NOT installed\"",
    "preview": "nuxt preview",
    "screenshots": "pnpm build && SCREENSHOTS=1 playwright test --project=screenshots",
    "seed": "tsx --env-file=.env scripts/seed/seed.ts",
    "setup": "tsx --env-file-if-exists=.env scripts/setup.ts",
    "smoke:prod": "playwright test -c playwright.prod.config.ts",
    "supabase": "supabase",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "typecheck": "nuxt typecheck",
    "vercel:keys": "node scripts/vercel-keys.mjs"
  },
  "dependencies": {
    "@formkit/auto-animate": "^0.10.0",
    "@internationalized/date": "^3.12.4",
    "@nuxt/ui": "^4.11.3",
    "@nuxtjs/i18n": "^10.6.0",
    "@nuxtjs/sitemap": "^9.1.0",
    "@nuxtjs/supabase": "^2.0.10",
    "@pinia/nuxt": "^1.0.3",
    "@resvg/resvg-js": "^2.6.2",
    "@sentry/nuxt": "^11.7.0",
    "@upstash/ratelimit": "^2.2.0",
    "@upstash/redis": "^1.39.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "@vue-email/components": "^0.0.21",
    "@vue-email/render": "^0.0.9",
    "consola": "^3.4.2",
    "date-fns": "^4.4.0",
    "driver.js": "^1.9.0",
    "nuxt": "^4.6.1",
    "nuxt-og-image": "^7.0.7",
    "nuxt-security": "^2.6.0",
    "pinia": "^4.1.0",
    "posthog-js": "^1.438.10",
    "satori": "^0.53.0",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.6.0",
    "@iconify-json/lucide": "^1.2.144",
    "@iconify-json/simple-icons": "^1.2.100",
    "@playwright/test": "catalog:",
    "@supabase/supabase-js": "^2.117.3",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.4",
    "axe-playwright": "^2.2.2",
    "dotenv": "^18.0.8",
    "nuxt-csurf": "^1.6.6",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "supabase": "^2.121.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.4",
    "vue-i18n-extract": "^2.0.7",
    "vue-tsc": "^3.3.13"
  }
}
