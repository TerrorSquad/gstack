{
  "name": "nuxt-supabase-starter",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "db:reset": "supabase db reset && pnpm seed",
    "db:types": "supabase gen types typescript --local --schema public > app/types/database.types.ts",
    "dev": "nuxt dev",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "generate": "nuxt generate",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "lint:i18n": "node --experimental-strip-types --no-warnings scripts/check-i18n.ts",
    "lint:i18n-keys": "node --experimental-strip-types --no-warnings scripts/check-i18n.ts --keys",
    "postinstall": "nuxt prepare",
    "preview": "nuxt preview",
    "screenshots": "playwright test --project=screenshots-desktop --project=screenshots-mobile",
    "screenshots:local": "bash scripts/screenshots-docker.sh",
    "screenshots:update": "bash scripts/screenshots-docker.sh --update-snapshots",
    "seed": "tsx --env-file=.env scripts/seed/seed.ts",
    "supabase": "supabase",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "typecheck": "nuxt typecheck"
  },
  "dependencies": {
    "@nuxt/ui": "^4.9.0",
    "@nuxtjs/i18n": "^10.4.1",
    "@nuxtjs/supabase": "^2.0.9",
    "@pinia/nuxt": "^0.11.3",
    "@sentry/nuxt": "^10.65.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "consola": "^3.4.2",
    "date-fns": "^4.4.0",
    "nuxt": "^4.4.8",
    "pinia": "^3.0.4",
    "vue": "^3.5.39",
    "vue-router": "^5.1.0"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.0.0",
    "@iconify-json/lucide": "^1.2.116",
    "@playwright/mcp": "0.0.78",
    "@playwright/test": "1.61.1",
    "@supabase/supabase-js": "^2.110.2",
    "@types/node": "^26.1.1",
    "axe-playwright": "^2.2.2",
    "dotenv": "^17.4.2",
    "oxfmt": "^0.58.0",
    "oxlint": "^1.73.0",
    "playwright-core": "^1.61.1",
    "supabase": "^2.109.1",
    "tsx": "^4.23.0",
    "typescript": "~5.9.3",
    "vitest": "^4.1.10",
    "vue-i18n-extract": "^2.0.7",
    "vue-tsc": "^3.3.7"
  }
}
