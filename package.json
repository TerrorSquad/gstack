{
  "name": "gstack",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "db:reset": "supabase db reset && pnpm seed",
    "db:types": "supabase gen types typescript --local --schema public > shared/types/database.types.ts",
    "dev": "nuxt dev",
    "doctor": "tsx --env-file-if-exists=.env scripts/doctor.ts",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "gen:auth-templates": "tsx scripts/gen-auth-templates.ts",
    "gen:layer": "tsx scripts/gen-layer.ts",
    "generate": "nuxt generate",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "lint:i18n": "node --experimental-strip-types --no-warnings scripts/check-i18n.ts && node --experimental-strip-types --no-warnings scripts/check-i18n.ts --keys",
    "lint:i18n-keys": "node --experimental-strip-types --no-warnings scripts/check-i18n.ts --keys",
    "postinstall": "nuxt prepare",
    "preview": "nuxt preview",
    "screenshots": "pnpm build && SCREENSHOTS=1 playwright test --project=screenshots",
    "seed": "tsx --env-file=.env scripts/seed/seed.ts",
    "setup": "tsx --env-file-if-exists=.env scripts/setup.ts",
    "supabase": "supabase",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "typecheck": "nuxt typecheck"
  },
  "dependencies": {
    "@formkit/auto-animate": "^0.10.0",
    "@nuxt/ui": "^4.11.0",
    "@nuxtjs/i18n": "^10.6.0",
    "@nuxtjs/sitemap": "^8.5.0",
    "@nuxtjs/supabase": "^2.0.10",
    "@pinia/nuxt": "^0.11.3",
    "@resvg/resvg-js": "^2.6.2",
    "@sentry/nuxt": "^10.73.0",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.3",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "@vue-email/components": "^0.0.21",
    "@vue-email/render": "^0.0.9",
    "consola": "^3.4.2",
    "date-fns": "^4.4.0",
    "driver.js": "^1.8.0",
    "nuxt": "^4.5.2",
    "nuxt-og-image": "^6.7.8",
    "nuxt-security": "^2.6.0",
    "pinia": "^3.0.4",
    "posthog-js": "^1.426.0",
    "satori": "^0.33.4",
    "vue": "^3.5.42",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.6.0",
    "@iconify-json/lucide": "^1.2.129",
    "@iconify-json/simple-icons": "^1.2.94",
    "@playwright/test": "1.62.1",
    "@supabase/supabase-js": "^2.115.0",
    "@types/node": "^26.4.1",
    "@vitest/coverage-v8": "^4.1.10",
    "axe-playwright": "^2.2.2",
    "dotenv": "^17.4.2",
    "nuxt-csurf": "^1.6.6",
    "oxfmt": "^0.66.0",
    "oxlint": "^1.81.0",
    "supabase": "^2.116.0",
    "tsx": "^4.23.13",
    "typescript": "~5.9.3",
    "vitest": "^4.1.10",
    "vue-i18n-extract": "^2.0.7",
    "vue-tsc": "^3.3.11"
  }
}
